# pipeline/.env.example — إعداد مبسّط للتجربة الأولى (3 أزواج، إطار زمني واحد)
# انسخ هذا الملف باسم .env واملأ القيم المطلوبة

MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER=/TradingAI/backups
MEGA_LOCAL_BACKUP_DIR=./data/backups
MEGA_DB_PATH=../bot/backend/data/trading.db
MEGA_RETENTION_DAILY=14
MEGA_RETENTION_WEEKLY=8
MEGA_RETENTION_MONTHLY=3
MEGA_VERIFY_REMOTE=true
MEGA_BACKUP_CLASS=daily

MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# مبسّط للتجربة الأولى: سنة واحدة بدل سنتين، عملية واحدة بدل 4
COLLECT_YEARS=1
MAX_WORKERS=1
MEMORY_LIMIT_GB=1.5
LOG_LEVEL=WARNING

# مفتاح الاتصال بين Python والبوت - يجب أن يطابق نفس القيمة في bot/backend/.env
ML_SERVER_API_KEY=غيّر_هذا_إلى_نص_عشوائي_32_حرف
OPERATOR_PASSWORD=في_الوضع_غير_الورقي_استخدم_سرًا_مختلفًا_وطويلًا_12_حرفًا_على_الأقل

# Optional browser CORS (comma-separated origins)
ML_CORS_ORIGINS=http://localhost:3000,http://localhost:4000
MT5_FALLBACK_YAHOO=false

# Local-only escape hatch; keep false on Back4App/public deployments
ML_SERVER_ALLOW_ANONYMOUS=false

# Trading safety
ML_REQUIRED=false
LIVE_TRADING_ACK=
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=3
MAX_EXPOSURE=1

MT5_BRIDGE_MODE=live
MT5_BRIDGE_API_KEY=
MT5_BRIDGE_ALLOW_ANONYMOUS=false

# Dedicated Railway -> Windows backup bridge token (>=32 chars). Keep secret; never commit .env.
BACKUP_API_TOKEN=
RAILWAY_BACKEND_URL=https://trading-ai-v10-railway-production-8950.up.railway.app
