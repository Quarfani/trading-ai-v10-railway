# First Back4App cloud test — PAPER ONLY
MODE=paper
DATA_SOURCE=binance
SYMBOLS=BTCUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=60000
ACCOUNT_BALANCE=10000
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=1
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.03
MIN_RR=1.5

# Backend auth
DASHBOARD_PASSWORD=REPLACE_WITH_12+_CHAR_PASSWORD
SESSION_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
OPERATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_12+_CHAR_PASSWORD

# Pipeline connection
ML_ENABLED=true
ML_SERVER_URL=https://YOUR-PIPELINE-URL
ML_SERVER_API_KEY=REPLACE_WITH_SHARED_32+_CHAR_SECRET

# Safe Binance public/testnet market data
BINANCE_ENV=testnet
BINANCE_FUTURES=true
BINANCE_API_KEY=
BINANCE_SECRET=

# Optional
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Trading safety
ML_REQUIRED=false
LIVE_TRADING_ACK=
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=3
MAX_EXPOSURE=1

MT5_BRIDGE_MODE=live
MT5_BRIDGE_API_KEY=
MT5_BRIDGE_ALLOW_ANONYMOUS=false
