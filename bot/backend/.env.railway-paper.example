# SAFE RAILWAY PAPER PROFILE
# Copy these values to Railway > Service > Variables.
# This profile is intentionally PAPER ONLY and must not contain live broker credentials.

DEPLOYMENT_PROFILE=railway-paper
MODE=paper
DATA_SOURCE=binance
ACCOUNT_NAME=railway-paper
ACCOUNT_BALANCE=10000

# Low-resource operation for Railway's 1GB trial limit
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=30000
DB_PATH=/app/data/trading.db

# Risk gates
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_HEAT=0.03
MAX_OPEN_TRADES=2
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=1
MAX_EXPOSURE=0.50
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_MINUTES=60
MIN_RR=1.5
MAX_SLIPPAGE_PIPS=100
# Optional asset-agnostic fill slippage cap (fraction). Leave unset to use Forex pips / non-Forex 0.5% default.
# MAX_SLIPPAGE_PCT=0.005
DAILY_PROFIT_TARGET=0.00
COMPOUNDING_ENABLED=false

# Required application secrets - generate your own values; never commit them.
DASHBOARD_PASSWORD=REPLACE_WITH_RANDOM_16_PLUS_CHAR_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_64_PLUS_CHAR_SECRET

# Public Binance market data only. Paper execution never submits orders.
BINANCE_ENV=mainnet
BINANCE_FUTURES=false
BINANCE_API_KEY=
BINANCE_SECRET=

# ML is OFF in the 1GB Railway paper profile to avoid unnecessary memory/network usage.
ML_ENABLED=false
ML_REQUIRED=false
ML_AUTO_TRAIN_ENABLED=false
AUTO_WFO_ENABLED=false
AUTO_SYMBOLS=false
NVIDIA_API_KEY=
ML_SERVER_URL=
ML_SERVER_API_KEY=

# Optional notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Railway paper keeps runtime backups on /app/data only.
# MEGA archive runs as a separate low-resource Windows agent; do not put MEGA credentials here.
S3_BACKUP_ENABLED=false
MEGA_BACKUP_ENABLED=false

# API/security
CORS_ORIGIN=http://localhost:3000
# Trust Railway's edge-overwritten X-Real-IP for per-client rate limiting.
# Only enable when traffic reaches this service through public Railway HTTP ingress.
TRUST_RAILWAY_X_REAL_IP=true
LOG_LEVEL=INFO

# Dedicated Windows backup bridge token (>=32 chars). Keep secret in Railway Variables.
BACKUP_API_TOKEN=
