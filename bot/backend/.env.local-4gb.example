# Safe local profile for a 4GB Windows PC. PAPER ONLY.
DEPLOYMENT_PROFILE=local
MODE=paper
DATA_SOURCE=binance
ACCOUNT_NAME=local-paper
ACCOUNT_BALANCE=10000
SYMBOLS=BTCUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=30000
DB_PATH=./data/trading.db

RISK_PER_TRADE=0.0025
MAX_PORTFOLIO_HEAT=0.02
MAX_OPEN_TRADES=1
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.01
MAX_WEEKLY_LOSS=0.03
MAX_DRAWDOWN=0.08
MAX_LEVERAGE=1
MAX_EXPOSURE=0.25
CONSECUTIVE_LOSS_LIMIT=3
COOLDOWN_MINUTES=60
MIN_RR=1.5
MAX_SLIPPAGE_PIPS=50
# Optional asset-agnostic fill slippage cap (fraction). Leave unset to use Forex pips / non-Forex 0.5% default.
# MAX_SLIPPAGE_PCT=0.005
DAILY_PROFIT_TARGET=0
COMPOUNDING_ENABLED=false

# START.bat generates these locally if bot/backend/.env does not exist.
DASHBOARD_PASSWORD=GENERATED_LOCALLY
SESSION_SECRET=GENERATED_LOCALLY

BINANCE_ENV=mainnet
BINANCE_FUTURES=false
BINANCE_API_KEY=
BINANCE_SECRET=

# Heavy compute stays off the 4GB PC.
ML_ENABLED=false
ML_REQUIRED=false
ML_AUTO_TRAIN_ENABLED=false
AUTO_WFO_ENABLED=false
AUTO_SYMBOLS=false
NVIDIA_API_KEY=
ML_SERVER_URL=
ML_SERVER_API_KEY=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
S3_BACKUP_ENABLED=false
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Optional MEGA archive agent (runs separately on Windows).
MEGA_BACKUP_ENABLED=false
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER=/TradingAI/backups
MEGA_BACKUP_CLASS=daily
