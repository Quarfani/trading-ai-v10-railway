# Local paper profile. Use unique secrets and never commit your real .env file.
DEPLOYMENT_PROFILE=local
MODE=paper
DATA_SOURCE=binance
ACCOUNT_NAME=local-paper
ACCOUNT_BALANCE=10000
ACCOUNT_CURRENCY=USD

# Paper risk controls
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_HEAT=0.03
MAX_OPEN_TRADES=2
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=1
MAX_EXPOSURE=0.50
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_MINUTES=60
MIN_RR=1.5
MAX_SLIPPAGE_PIPS=100
MAX_SLIPPAGE_PCT=0.005
DAILY_PROFIT_TARGET=0
COMPOUNDING_ENABLED=false

# Binance public market data only. Paper mode does not submit broker orders.
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=30000
DB_PATH=./data/trading.db

# Generate unique values before starting the local API.
DASHBOARD_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_64_CHARS
OPERATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD_AT_LEAST_16_CHARS
TOKEN_TTL_SECONDS=28800

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Use only the public Spot market-data endpoint for this paper profile.
BINANCE_ENV=mainnet
BINANCE_FUTURES=false
BINANCE_API_KEY=
BINANCE_SECRET=

# Keep ML and parameter mutation disabled for the local profile.
ML_ENABLED=false
ML_REQUIRED=false
ML_AUTO_TRAIN_ENABLED=false
AUTO_WFO_ENABLED=false
NVIDIA_API_KEY=
ML_SERVER_URL=
ML_SERVER_API_KEY=

# Optional notifications.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Local paper profile uses the runtime SQLite backup only.
S3_BACKUP_ENABLED=false
MEGA_BACKUP_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENCRYPTION_KEY=
BACKUP_API_TOKEN=

# Explicitly disable the news gate locally if no calendar integration is configured.
NEWS_FILTER_ENABLED=false
NEWS_BLOCK_MEDIUM_IMPACT=false

# Optional MT5 settings. They are not needed in this Binance-data paper profile.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER_NAME=
MT5_BRIDGE_URL=http://127.0.0.1:5000
MT5_BRIDGE_API_KEY=
MT5_LIVE_TRADING_ACK=

# Not used in paper mode. Never copy production credentials into this file.
LIVE_TRADING_ACK=
TRUST_RAILWAY_X_REAL_IP=false
