# Local paper profile using public Binance market data only.
# Replace all placeholder secrets with random unique values before starting the app.

DEPLOYMENT_PROFILE=local
MODE=paper
DATA_SOURCE=binance
ACCOUNT_NAME=local-paper
ACCOUNT_CURRENCY=USD
ACCOUNT_BALANCE=10000

# Conservative paper risk defaults. Live profiles enforce their own acknowledgments.
RISK_PER_TRADE=0.005
MAX_PORTFOLIO_HEAT=0.03
MAX_OPEN_TRADES=3
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_DRAWDOWN=0.10
DAILY_PROFIT_TARGET=0.00
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_MINUTES=60
MIN_RR=1.5
MAX_SLIPPAGE_PIPS=3
# Optional asset-agnostic fill slippage cap (fraction).
# MAX_SLIPPAGE_PCT=0.005
MAX_LEVERAGE=1
MAX_EXPOSURE=0.50

# Supported Binance spot symbols; paper execution sends no orders to Binance.
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=60000
DB_PATH=./data/trading.db

API_PORT=4000
DASHBOARD_PASSWORD=REPLACE_WITH_RANDOM_24_PLUS_CHAR_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_64_PLUS_CHAR_SECRET
OPERATOR_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_24_PLUS_CHAR_SECRET
CORS_ORIGIN=http://localhost:3000

# Optional ML integrations are disabled in the local 4GB profile.
ML_ENABLED=false
ML_REQUIRED=false
ML_AUTO_TRAIN_ENABLED=false
AUTO_WFO_ENABLED=false
ML_SERVER_URL=
ML_SERVER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Public market data requires no Binance API key in paper mode.
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_ENV=mainnet
BINANCE_FUTURES=false

# Not used by the local Binance paper profile. Keep bridge access restricted.
MT5_BRIDGE_URL=http://127.0.0.1:5000
MT5_BRIDGE_PORT=5000
MT5_BRIDGE_API_KEY=
MT5_BRIDGE_MODE=paper
MT5_BRIDGE_ALLOW_ANONYMOUS=false
MT5_LIVE_TRADING_ACK=
LIVE_TRADING_ACK=

# Optional notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Backups stay local unless a supported provider is deliberately configured.
S3_BACKUP_ENABLED=false
MEGA_BACKUP_ENABLED=false
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER=/TradingBot

NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MEDIUM_IMPACT=false
COMPOUNDING_ENABLED=false
COMPOUNDING_REINVEST_RATE=0.8
AUTO_SYMBOLS=false
LOG_LEVEL=INFO
