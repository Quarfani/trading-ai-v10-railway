# bot/backend/.env.example — إعداد مبسّط للتجربة الأولى
# انسخ هذا الملف باسم .env واملأ القيم المطلوبة

MODE=paper
ACCOUNT_NAME=MyBot
ACCOUNT_BALANCE=10000

RISK_PER_TRADE=0.01
MAX_PORTFOLIO_HEAT=0.06
MAX_OPEN_TRADES=3
MIN_CONFIDENCE=0.60
MAX_DAILY_LOSS=0.03
DAILY_PROFIT_TARGET=0.05
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_MINUTES=60
MIN_RR=1.5
MAX_SLIPPAGE_PIPS=3
# Optional asset-agnostic fill slippage cap (fraction). Leave unset to use Forex pips / non-Forex 0.5% default.
# MAX_SLIPPAGE_PCT=0.005

# ═══ التبسيط الموصى به للتجربة الأولى ═══
SYMBOLS=EURUSD,XAUUSD,BTCUSDT
TIMEFRAMES=H1
SCAN_INTERVAL=600000

DB_PATH=./data/trading.db

API_PORT=4000
DASHBOARD_PASSWORD=ضع_كلمة_مرور_قوية_12_حرف_على_الأقل
SESSION_SECRET=غيّر_هذا_إلى_نص_عشوائي_طويل_64_حرف
OPERATOR_PASSWORD=في_الوضع_غير_الورقي_استخدم_سرًا_مختلفًا_وطويلًا_12_حرفًا_على_الأقل
CORS_ORIGIN=http://localhost:3000

ML_SERVER_URL=https://YOUR-PIPELINE-URL
ML_SERVER_API_KEY=غيّر_هذا_إلى_نص_عشوائي_32_حرف
ML_ENABLED=true

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

MT5_BRIDGE_URL=http://127.0.0.1:5000
MT5_BRIDGE_PORT=5000
MT5_BRIDGE_API_KEY=

BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_ENV=testnet
BINANCE_FUTURES=true

S3_BACKUP_ENABLED=false
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_FOLDER=/TradingBot
MEGA_ENC_KEY=

NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MEDIUM_IMPACT=false
COMPOUNDING_ENABLED=false
AUTO_SYMBOLS=false
LOG_LEVEL=WARNING
CONSENSUS_MIN_WEIGHT=0.25
CONSENSUS_DOMINANCE=0.60
CONSENSUS_MIN_STRATEGIES=1
CONSENSUS_ROLLING_WINDOW=30
CONSENSUS_GATE_MIN_WIN_RATE=0.48
CONSENSUS_GATE_MIN_SHARPE=0.80
CONSENSUS_GATE_MIN_TRADES=20
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Trading safety
ML_REQUIRED=false
LIVE_TRADING_ACK=
MAX_DRAWDOWN=0.10
MAX_LEVERAGE=3
MAX_EXPOSURE=1

MT5_BRIDGE_MODE=live
MT5_BRIDGE_API_KEY=
MT5_BRIDGE_ALLOW_ANONYMOUS=false
